# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). .env.local is
# gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_. Only used by admin server actions after
# they've independently verified the caller (see src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Added in a later phase (PayHere payments):
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=

# Server-only — powers the question bank's "Import from PDF" feature
# (reads a past-paper PDF and extracts questions via Gemini's native
# document support). Get a free key at aistudio.google.com (no card needed
# to start; has rate limits on the free tier). PDF import shows a clear
# error instead of crashing when this is unset.
# GEMINI_API_KEY=
